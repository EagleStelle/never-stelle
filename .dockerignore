# Default to a tiny build context. Re-include only files copied by Dockerfile.
*

!Dockerfile
!requirements.txt

!backend/
!backend/**

!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**

# Generated files and local runtime state, even under included trees.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/

frontend/node_modules/
frontend/dist/
frontend/.vite/

.git/
.local/
.venv/
data/
media/
scratch/
library/
settings.json
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.tar
*.log
